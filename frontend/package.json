{
  "name": "cot-manipulation-monitor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run build && npx wrangler dev",
    "dev:local": "npm run build && npx wrangler dev --local",
    "build": "vite build",
    "preview": "vite preview",
    "import": "tsx scripts/import-conversations.ts",
    "import:judge-results": "tsx scripts/import-judge-results.ts",
    "seed:generate": "tsx scripts/seed-database.ts",
    "seed:local": "npx wrangler d1 execute thoughtguards-db --local --file=./db/seed_data.sql",
    "migrate:local": "tsx scripts/apply-local-migrations.ts",
    "test:local": "tsx scripts/test-local.ts",
    "test:tools": "tsx scripts/test-tool-calls.ts",
    "test:conversation": "tsx scripts/test-conversation-flow.ts",
    "test:scenarios": "tsx scripts/test-scenarios.ts",
    "test:production": "tsx scripts/test-production.ts",
    "test:production:seeding": "tsx scripts/test-production-seeding.ts",
    "test:production:tools": "tsx scripts/test-production-tools.ts",
    "test:production:conversation": "tsx scripts/test-production-conversation.ts",
    "test:production:scenarios": "tsx scripts/test-production-scenarios.ts",
    "verify:seeding": "tsx scripts/verify-seeding.ts",
    "check:db": "tsx scripts/check-db-status.ts",
    "validate:integration": "tsx scripts/validate-integration.ts",
    "setup:local": "npm run migrate:local && npm run seed:generate && npm run seed:local",
    "db:create-local": "npx wrangler d1 create thoughtguards-db --local",
    "db:reset-local": "npm run migrate:local && npm run seed:generate && npm run seed:local",
    "deploy": "node -e \"require('child_process').execSync(process.platform === 'win32' ? 'powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1' : 'bash scripts/deploy.sh', {stdio: 'inherit'})\""
  },
  "dependencies": {
    "@google/genai": "^1.3.0",
    "hono": "^4.11.3",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.12.0",
    "recharts": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260103.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "better-sqlite3": "^12.5.0",
    "connect-history-api-fallback": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wrangler": "^4.54.0"
  }
}
