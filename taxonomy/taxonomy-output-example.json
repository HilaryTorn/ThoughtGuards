{
  "title": "Manipulation Evaluation",
  "type": "object",
  "required": [
    "conversation_id",
    "manipulation_evaluations"
  ],
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "Conversation identifier (UUID, slug, DB id, etc.)"
    },
    "manipulation_evaluations": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/Evaluation"
      }
    }
  },
  "$defs": {
    "Evaluation": {
      "type": "object",
      "required": [
        "evaluator_id",
        "created_at",
        "patterns"
      ],
      "properties": {
        "evaluator_id": {
          "type": "string"
        },
        "evaluator_type": {
          "type": "string",
          "enum": [
            "human",
            "model",
            "hybrid"
          ],
          "default": "human"
        },
        "model_name": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "method_skill": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional: harness/method label",
          "default": null
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "patterns": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/Pattern"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "Pattern": {
      "type": "object",
      "required": [
        "triad_pattern_id",
        "short_desc",
        "prominence",
        "confidence",
        "quotes"
      ],
      "properties": {
        "triad_pattern_id": {
          "type": "string",
          "description": "Either a composite like 'T4|H1|W4' or a stable id like 'TP_0007'"
        },
        "labels": {
          "type": "object",
          "description": "Optional: explicit axis labels for easier querying",
          "properties": {
            "TARGET": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^T[0-9]+$",
              "default": null
            },
            "HOW": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^H[0-9]+$",
              "default": null
            },
            "WHY": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^W[0-9]+$",
              "default": null
            }
          },
          "additionalProperties": false
        },
        "short_desc": {
          "type": "string",
          "maxLength": 200
        },
        "prominence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How salient/central this pattern is in the conversation (0..1)"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Evaluator confidence in the labeling (0..1)"
        },
        "severity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "Optional: harm/risk severity (0..5)"
        },
        "quotes": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/Quote"
          }
        },
        "evidence_notes": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "counterevidence_notes": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "Quote": {
      "type": "object",
      "required": [
        "speaker",
        "message_index",
        "text"
      ],
      "properties": {
        "speaker": {
          "type": "string",
          "enum": [
            "user",
            "assistant",
            "system",
            "tool",
            "unknown"
          ]
        },
        "message_index": {
          "type": "integer",
          "minimum": 0,
          "description": "Index in the transcript after normalization"
        },
        "char_span": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false,
          "default": null
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
